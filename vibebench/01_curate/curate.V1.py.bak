"""
Step 1 - Curate the gold set.

Reads the AIDev parquet tables and produces `corpus/gold_set.parquet`: one row
per in-scope merged PR, with the repo metadata, the AI-touched source files, and
a merge-commit SHA fallback for the clone stage.

Selection policy lives in config.py:
  - language in TARGET_LANGUAGES
  - stars >= MIN_STARS
  - permissive license
  - PR is merged and touches >= 1 source file (SOURCE_EXTENSIONS)
  - balanced per-agent sampling (keep small agents whole, cap large ones)

Copilot special case: pr_commit_details carries NO filenames for Copilot (an
AIDev collection gap), so the "touches >= 1 source file" pre-filter cannot be
applied. Copilot PRs are sampled on repo criteria alone with
`files_source="git_diff"`; Step 2 derives their touched files from the merge
commit's diff and drops PRs that touch no source file.

Sticky sampling: if a previous gold_set.parquet exists, PRs already in it are
kept (when still eligible) and only topped up to the cap with new draws. This
keeps earlier clone caches and labeling samples valid across re-curation.

Run:  python vibebench/01_curate/curate.py             (Python corpus, default)
      python vibebench/01_curate/curate.py --lang ts   (TypeScript corpus)
"""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

import numpy as np
import pandas as pd

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import config as C  # noqa: E402


# Language profiles: everything language-specific in one place. The Python
# profile reproduces the original behaviour byte-for-byte; the TS profile adds
# the .d.ts exclusion (endswith(".ts") would otherwise match declaration files,
# which carry no implementation) and generated/vendored path exclusions.
LANG_PROFILES = {
    "py": {
        "languages": C.TARGET_LANGUAGES,
        "extensions": C.SOURCE_EXTENSIONS,
        "excluded_parts": (),
        "gold_set": C.GOLD_SET,
        "clone_manifest": C.CLONE_MANIFEST,
        # Added 2026-08-17: Python is now restricted to the same 3 agents as
        # Java. Without this the run silently included all 6 agents in the
        # dataset (including the unvalidated Google_Jules).
        "only_agents": C.PY_ONLY_AGENTS,
    },
    "ts": {
        "languages": C.TS_TARGET_LANGUAGES,
        "extensions": C.TS_SOURCE_EXTENSIONS,
        "excluded_parts": C.TS_EXCLUDED_PATH_PARTS,
        "gold_set": C.GOLD_SET_TS,
    },
    # Java: see the JAVA_* block in config.py. Since 2026-08-17 this is a
    # 3-agent study like Python (was single-agent under AIDev-full), so it uses
    # the SAME per-agent cap; `per_repo_cap` is None and within-agent repo
    # concentration is handled by macro-per-repo reporting, not by sampling.
    # `filter_by_file` scopes by .java extension rather than the repo's headline
    # language -- see the language gate in attach_touched_files for how that
    # interacts with git_diff rows.
    "java": {
        "languages": C.JAVA_TARGET_LANGUAGES,
        "extensions": C.JAVA_SOURCE_EXTENSIONS,
        "excluded_parts": C.JAVA_EXCLUDED_PATH_PARTS,
        "gold_set": C.GOLD_SET_JAVA,
        "clone_manifest": C.CLONE_MANIFEST_JAVA,
        "only_agents": C.JAVA_ONLY_AGENTS,
        "per_repo_cap": C.JAVA_PER_REPO_PR_CAP,
        "filter_by_file": C.JAVA_FILTER_BY_FILE,
        "repo_stratified": C.JAVA_REPO_STRATIFIED_DRAW,
    },
}


def is_source_file(path: str, profile: dict) -> bool:
    """True if `path` is an in-scope source file for this language profile."""
    f = path.lower()
    if f.endswith(".d.ts"):
        return False
    if any(part in f for part in profile["excluded_parts"]):
        return False
    return any(f.endswith(ext) for ext in profile["extensions"])


def load_candidates(profile: dict) -> pd.DataFrame:
    """Merged PRs joined to repo metadata, filtered by language/stars/license."""
    # C.PR_TABLE / C.REPO_TABLE, never a hardcoded filename: in AIDev-7.6M the
    # plain `pull_request.parquet` / `repository.parquet` are only the >100-star
    # AIDev-pop subset (361,296 of 7,685,281 PRs), so hardcoding them would
    # silently shrink the corpus by ~95%. See the DATA_DIR note in config.py.
    repo = pd.read_parquet(
        C.DATA_DIR / C.REPO_TABLE,
        columns=["id", "full_name", "url", "language", "stars", "license"],
    )
    pr = pd.read_parquet(
        C.DATA_DIR / C.PR_TABLE,
        columns=["id", "number", "repo_id", "repo_url", "agent", "merged_at", "html_url"],
    )
    pr = pr[pr["merged_at"].notna()].copy()

    merged = pr.merge(
        repo, left_on="repo_id", right_on="id", suffixes=("_pr", "_repo")
    )
    lic = merged["license"].fillna("").str.lower()
    mask = (merged["stars"] >= C.MIN_STARS) & lic.isin(C.PERMISSIVE_LICENSES)
    # `filter_by_file` profiles skip the repo's headline-language filter: the
    # unit of analysis is the SOURCE FILE, and a repo whose primary language is
    # Kotlin or Go can still contain real Java. attach_touched_files() then does
    # the real filtering by extension, which is the more faithful test.
    if not profile.get("filter_by_file"):
        mask &= merged["language"].isin(profile["languages"])
    return merged[mask].copy()


def attach_touched_files(cand: pd.DataFrame, profile: dict) -> pd.DataFrame:
    """Attach the list of AI-touched source files per PR.

    Reads only the light columns (not the huge `patch`) and filters to the
    candidate PR ids to keep memory bounded.

    TWO SOURCES, in preference order (changed 2026-08-17 -- see below):
      * `files_source="dataset"` -- pr_commit_details lists the PR's files. Free
        and exact, so it is preferred whenever available. Rows are kept only if
        they touch >= 1 in-scope source file, which is a real pre-filter.
      * `files_source="git_diff"` -- no file list in the dataset. The PR is kept
        anyway with an empty list; Step 2 derives the real list from the merge
        commit's diff and drops PRs that touch no source file. This is the path
        Copilot has always used (its pr_commit_details filenames are 100% null).

    WHY NON-COPILOT AGENTS NOW GET THE GIT_DIFF FALLBACK TOO. Under AIDev-full
    this did not matter: pr_commit_details covered nearly every PR. Under
    AIDev-7.6M it covers only 197,330 of 7,685,281 PRs (2.6%) -- the ">100 star"
    AIDev-pop subset, with **ZERO coverage below 100 stars** and only ~50%
    coverage above it. Measured effect of the old inner join on that dataset:
    Claude_Code drops 26,055 eligible Python PRs -> 505 usable, and 1,954
    eligible Java PRs -> **45**, which is too few to measure. Codex/Copilot are
    hit far less, so the loss was BOTH large and agent-biased -- the same class
    of defect as the old no-merge-SHA drop (17x agent bias), which is already
    fixed elsewhere in this pipeline.
    Keeping the PR and resolving files from git removes that bias and also
    removes an undocumented SELECTION EFFECT: with the inner join the corpus was
    silently restricted to PRs that happen to sit in the star-correlated pop
    subset.
    """
    pr_ids = set(cand["id_pr"].tolist())
    det = pd.read_parquet(
        C.DATA_DIR / "pr_commit_details.parquet",
        columns=["pr_id", "filename", "status"],
    )
    det = det[det["pr_id"].isin(pr_ids)]
    # Keep only added/modified/renamed source files (deletions carry no code to score).
    det = det[det["status"].isin({"added", "modified", "renamed", "changed"})]
    is_src = det["filename"].fillna("").apply(lambda f: is_source_file(f, profile))
    det = det[is_src]

    grouped = (
        det.groupby("pr_id")["filename"]
        .apply(lambda s: sorted(set(s)))
        .rename("touched_files")
    )

    # NO PER-AGENT SPECIAL CASE (changed 2026-08-19). This used to force every
    # Copilot PR onto the git_diff path with the comment "Copilot never has
    # usable filenames". That was TRUE of AIDev-full, and is FALSE of AIDev-7.6M:
    # measured over merged PRs, pr_commit_details filenames are 97.3% non-null
    # for Copilot (2,039,969 of 2,097,609 rows), in line with every other agent
    # (99.4-100%).
    #
    # Keeping the hard-coded exception threw away exact, free file lists and
    # pushed Copilot alone through Step-2 git resolution -- which is precisely
    # the 56.3% Copilot attrition (641 drawn -> 280 analyzable, vs ~9-11% for the
    # other agents) recorded in the survival-aware-stickiness note in
    # balanced_sample. That attrition was self-inflicted, and being single-agent
    # it was an agent bias in the same family as the other two already fixed here.
    #
    # The LEFT join below already routes correctly for every agent: a PR with a
    # usable in-scope file list becomes `dataset`, one without becomes `git_diff`.
    # Agent identity is not consulted.
    out = cand.merge(grouped, left_on="id_pr", right_index=True, how="left")
    has_files = out["touched_files"].notna()
    out["files_source"] = has_files.map({True: "dataset", False: "git_diff"})
    out.loc[~has_files, "touched_files"] = pd.Series(
        [[] for _ in range((~has_files).sum())],
        index=out.index[~has_files], dtype=object,
    )
    out = out.reset_index(drop=True)

    # LANGUAGE GATE FOR git_diff ROWS (added 2026-08-19 -- fixes an 8x agent bias).
    #
    # A `filter_by_file` profile (Java) deliberately skips the repo's headline-
    # language filter in load_candidates, because the unit of analysis is the
    # SOURCE FILE and real Java lives in Kotlin/Scheme/TS-primary repos too. That
    # is correct for `dataset` rows, which are then filtered by extension above.
    #
    # It was NOT correct for `git_diff` rows: they carry no file list at curation
    # time, so nothing constrained them to the language at all. Measured on
    # AIDev-7.6M, the Java candidate pool was 253,523 PRs of which only 6,239
    # (2.46%) were even in a Java repo. balanced_sample over-draws git_diff rows
    # by GIT_DIFF_OVERDRAW to survive Step-2 attrition, so it was drawing ~1,046
    # essentially random PRs per short agent and expecting ~15 of them to be Java.
    #
    # Projected corpus WITHOUT this gate: OpenAI_Codex 500, Copilot 500,
    # Claude_Code ~60 -- because Claude_Code has only 45 dataset-supplied Java
    # file lists (pr_commit_details covers 2.6% of AIDev-7.6M) and had to fill the
    # rest from the unconstrained pool. That is the same agent-biased silent loss
    # as the old no-merge-SHA drop (17x) and the old pr_commit_details inner join.
    #
    # The gate: a git_diff row is kept only if the REPOSITORY's primary language
    # is in scope. That is the only language signal available before cloning. The
    # exact path keeps its cross-language reach (398 of 2,391 dataset Java PRs sit
    # in non-Java-primary repos), so the concession is limited to the rows that
    # could not be checked anyway.
    if profile.get("filter_by_file") and "language" in out.columns:
        langs = set(profile["languages"])
        is_gd = out["files_source"] == "git_diff"
        keep = ~is_gd | out["language"].isin(langs)
        dropped = int((~keep).sum())
        by_agent = out.loc[~keep, "agent"].value_counts().to_dict() if dropped else {}
        out = out[keep].copy()
        print(f"[curate] language gate on git_diff rows: dropped {dropped} PRs "
              f"outside {sorted(langs)} ({by_agent})")

    out["n_touched_files"] = out["touched_files"].apply(len)
    n_ds = int((out["files_source"] == "dataset").sum())
    print(f"[curate] file lists: {n_ds} from dataset, "
          f"{len(out) - n_ds} deferred to git_diff (Step 2 resolves + trims)")
    return out


def attach_commit_shas(df: pd.DataFrame) -> pd.DataFrame:
    """Attach every PR's own commit SHAs (from pr_commits).

    Two consumers:
      * Step 2 uses them to derive Copilot's touched files when the timeline
        has no merge SHA.
      * The delta harnesses use them (gitsnap.delta_pair) to reconstruct a
        before/after pair when the timeline has no merge SHA at all: the tip
        of this commit set is the "after", and the branch point (the parent
        lying outside the set) is the "before".

    Attached for ALL agents since 2026-07-28. Previously only Copilot rows got
    them, which meant the no-merge-SHA loss (~15% of TS PRs, ~10% of Python)
    was only recoverable for Copilot -- an avoidable, agent-biased data loss.
    """
    pc = pd.read_parquet(C.DATA_DIR / "pr_commits.parquet", columns=["pr_id", "sha"])
    pc = pc[pc["pr_id"].isin(set(df["id_pr"]))]
    grouped = pc.groupby("pr_id")["sha"].apply(list).rename("commit_shas")
    out = df.merge(grouped, left_on="id_pr", right_index=True, how="left")
    out["commit_shas"] = out["commit_shas"].where(out["commit_shas"].notna(), None)
    return out


def attach_merge_sha(df: pd.DataFrame) -> pd.DataFrame:
    """Attach the merge-commit SHA (fallback for clone) from pr_timeline."""
    pr_ids = set(df["id_pr"].tolist())
    tl = pd.read_parquet(
        C.DATA_DIR / "pr_timeline.parquet",
        columns=["pr_id", "event", "commit_id"],
    )
    tl = tl[(tl["pr_id"].isin(pr_ids)) & (tl["event"] == "merged")]
    tl = tl.drop_duplicates("pr_id").set_index("pr_id")["commit_id"].rename("merge_sha")
    return df.merge(tl, left_on="id_pr", right_index=True, how="left")


def _draw(pool: pd.DataFrame, n: int, profile: dict | None = None) -> pd.DataFrame:
    """Take `n` rows from `pool`, repo-stratified when the profile asks for it.

    Default is a uniform random sample (the historic behaviour). When the
    profile sets `repo_stratified`, rows are taken ROUND-ROBIN across
    `full_name` instead: one PR from each repository, then a second from each,
    and so on. That yields the same `n` PRs spread over far more repositories --
    see the JAVA_REPO_STRATIFIED_DRAW note in config.py for the measured effect
    and for what it changes about interpretation.

    Repositories are visited largest-pool-first so that when `n` is smaller than
    the repository count the draw still favours repos with more material, and
    each repository's own rows are shuffled with RANDOM_SEED so the choice
    within a repository stays random and reproducible.
    """
    n = int(min(n, len(pool)))
    if n <= 0:
        return pool.iloc[:0]
    if not (profile or {}).get("repo_stratified") or "full_name" not in pool.columns:
        return pool.sample(n, random_state=C.RANDOM_SEED)

    rng = np.random.default_rng(C.RANDOM_SEED)
    buckets = {r: list(rng.permutation(g.index.to_numpy()))
               for r, g in pool.groupby("full_name")}
    order = sorted(buckets, key=lambda r: -len(buckets[r]))
    picked: list = []
    depth = 0
    while len(picked) < n:
        progressed = False
        for r in order:
            if depth < len(buckets[r]):
                picked.append(buckets[r][depth])
                progressed = True
                if len(picked) >= n:
                    break
        if not progressed:
            break
        depth += 1
    return pool.loc[picked]


def balanced_sample(df: pd.DataFrame, gold_path: Path,
                    profile: dict | None = None) -> pd.DataFrame:
    """Keep every PR from small agents; cap large agents at PER_AGENT_PR_CAP.

    Sticky: PRs already in a previous gold set (for THIS language) are kept
    first (when still eligible), so re-curation with wider filters only ADDS
    PRs -- earlier clone caches and labeling samples stay valid.

    PER-REPO MODE (`profile["per_repo_cap"]`, used by Java): caps by repository
    instead of by agent. Java has only one agent with usable data, so the
    imbalance worth controlling is across repositories -- uncapped, 53% of the
    Java corpus sits in three repos. Stickiness works the same way.
    """
    prev_ids: set = set()
    if gold_path.exists():
        prev_ids = set(pd.read_parquet(gold_path, columns=["pr_id"])["pr_id"])
        print(f"[curate] sticky sampling against previous gold set ({len(prev_ids)} PRs)")

    # SURVIVAL-AWARE STICKINESS (2026-08-17). A previously drawn PR only holds a
    # slot if Step 2 actually extracted a source file from it. Without this, PRs
    # that FAILED extraction stay sticky forever and consume cap budget, so a
    # re-curation cannot repair an under-filled agent: with cap=500 and 641 sticky
    # Copilot PRs, `n_new = cap - len(sticky)` goes NEGATIVE and the draw silently
    # truncates instead of topping up.
    # This matters because attrition is agent-dependent and large: measured on the
    # first AIDev-7.6M pass, Copilot (whose file lists must all come from git)
    # lost 56.3% -- 641 drawn -> 280 analyzable -- against ~9-11% for the two
    # agents with dataset-supplied lists. Leaving that unrepaired would hand back
    # exactly the imbalance this re-run exists to remove.
    manifest = (profile or {}).get("clone_manifest")
    if manifest is not None and Path(manifest).exists() and prev_ids:
        man = pd.read_parquet(manifest, columns=["pr_id", "extract_status"])
        alive = set(man.loc[man["extract_status"] == "ok", "pr_id"])
        dropped = len(prev_ids) - len(prev_ids & alive)
        prev_ids &= alive
        if dropped:
            print(f"[curate] survival-aware: {dropped} previously drawn PRs had no "
                  f"extractable source file and release their slot "
                  f"({len(prev_ids)} keep it)")

    cap = (profile or {}).get("per_repo_cap")
    # REMOVED 2026-08-17: `only_agents and not per_repo_cap` used to mean "emit
    # everything uncapped". That was correct ONLY while Java was a single-agent
    # study -- with a 3-agent set it would hand the corpus to whichever agent has
    # the most PRs (Copilot in Java) and destroy the balance this run exists to
    # create. Both languages now go through the per-agent cap below.
    # Within-agent repo concentration is still handled the documented way: macro
    # per-repo averaging plus `top_repo_share` in the report, not by a repo cap.
    if cap:
        parts = []
        for _, grp in df.groupby("full_name"):
            if len(grp) > cap:
                keep = grp[grp["id_pr"].isin(prev_ids)]
                rest = grp[~grp["id_pr"].isin(prev_ids)]
                n_new = cap - len(keep)
                grp = (pd.concat([keep, rest.sample(n_new, random_state=C.RANDOM_SEED)])
                       if n_new > 0 else keep.head(cap))
            parts.append(grp)
        out = pd.concat(parts).reset_index(drop=True)
        rc = out.groupby("full_name").size()
        print(f"[curate] per-repo cap {cap}: {len(out)} PRs across {len(rc)} repos; "
              f"top-repo share {rc.max()/len(out):.1%}, top-3 {rc.nlargest(3).sum()/len(out):.1%}")
        return out

    # Draw order within an agent (added 2026-08-17): sticky rows first (as
    # before), then rows whose file list came from the DATASET (exact, already
    # pre-filtered to touch >=1 source file, ~0% Step-2 attrition), then
    # git_diff rows. git_diff rows are OVER-DRAWN by C.GIT_DIFF_OVERDRAW because
    # Step 2 discovers and drops the ones that touch no in-scope source file --
    # under-drawing would land the corpus below the cap.
    parts = []
    for agent, grp in df.groupby("agent"):
        if len(grp) <= C.PER_AGENT_PR_CAP:
            parts.append(grp)
            continue
        sticky = grp[grp["id_pr"].isin(prev_ids)]
        pool = grp[~grp["id_pr"].isin(prev_ids)]
        n_new = C.PER_AGENT_PR_CAP - len(sticky)
        if n_new <= 0:
            parts.append(sticky.head(C.PER_AGENT_PR_CAP))
            continue

        exact = pool[pool["files_source"] == "dataset"]
        approx = pool[pool["files_source"] != "dataset"]
        take_exact = _draw(exact, min(n_new, len(exact)), profile)
        short = n_new - len(take_exact)
        chosen = [sticky, take_exact]
        if short > 0 and len(approx):
            want = min(int(round(short * C.GIT_DIFF_OVERDRAW)), len(approx))
            chosen.append(_draw(approx, want, profile))
        out_grp = pd.concat(chosen)
        parts.append(out_grp)
        print(f"[curate]   {agent}: {len(sticky)} sticky + {len(take_exact)} dataset"
              f" + {len(out_grp) - len(sticky) - len(take_exact)} git_diff"
              f" (over-drawn {C.GIT_DIFF_OVERDRAW}x for Step-2 attrition)"
              f" = {len(out_grp)} drawn, cap {C.PER_AGENT_PR_CAP}")
    return pd.concat(parts).reset_index(drop=True)


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--lang", choices=sorted(LANG_PROFILES), default="py",
                    help="language profile (default: py -- original behaviour)")
    args = ap.parse_args()
    profile = LANG_PROFILES[args.lang]
    gold_path = profile["gold_set"]

    C.CORPUS_DIR.mkdir(parents=True, exist_ok=True)

    cand = load_candidates(profile)
    print(f"[curate] ({args.lang}) candidate merged PRs after lang/stars/license: {len(cand)}")

    only = profile.get("only_agents")
    if only:
        before = len(cand)
        cand = cand[cand["agent"].isin(only)]
        print(f"[curate] restricted to {only}: {before} -> {len(cand)} candidate PRs")
    cand = attach_touched_files(cand, profile)
    print(f"[curate] PRs touching >=1 source file: {len(cand)}")

    sample = balanced_sample(cand, gold_path, profile)
    sample = attach_merge_sha(sample)
    sample = attach_commit_shas(sample)

    gold = pd.DataFrame({
        "pr_id": sample["id_pr"],
        "pr_number": sample["number"],
        "agent": sample["agent"],
        "merged_at": sample["merged_at"],
        "repo_id": sample["repo_id"],
        "full_name": sample["full_name"],       # e.g. "owner/name"
        "repo_url": sample["repo_url"],
        "stars": sample["stars"],
        "license": sample["license"],
        "merge_sha": sample["merge_sha"],
        "n_touched_files": sample["n_touched_files"],
        "touched_files": sample["touched_files"],
        "files_source": sample["files_source"],
        "commit_shas": sample["commit_shas"],
    }).sort_values(["agent", "full_name", "pr_number"]).reset_index(drop=True)

    gold.to_parquet(gold_path, index=False)

    print("\n[curate] gold set written to", gold_path)
    print(f"[curate] total PRs: {len(gold)} across {gold['repo_id'].nunique()} repos")
    print("\nPer-agent breakdown:")
    summary = gold.groupby("agent").agg(
        prs=("pr_id", "size"),
        repos=("repo_id", "nunique"),
        median_files=("n_touched_files", "median"),
    )
    print(summary.to_string())


if __name__ == "__main__":
    main()
