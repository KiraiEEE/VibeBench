# =====================================================================
#  VibeBench , what is NOT backed up, and why
#
#  Rule: commit anything that took HUMAN or JUDGE effort to produce, or
#  that cannot be regenerated from what is committed. Exclude anything a
#  script can rebuild from the committed inputs.
#
#  Working tree is ~17 GB. The committed set is ~35 MB. Everything left
#  out is either a cache, a public download, or somebody else's source.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Other people's repositories (11.7 GB)
#    Git clones of the 174 benchmarked repos. Rebuildable from
#    gold_set*.parquet, which records every (repo, pr_number, merge_sha).
#    Also: republishing 174 third-party repos wholesale is a licensing
#    mess we do not need to be in.
# ---------------------------------------------------------------------
vibebench/corpus/clones/

# ---------------------------------------------------------------------
# 2. Extracted third-party source (121 MB, 13k files)
#    Per-PR file dumps from those same repos. Same reasoning as above.
#    Rebuild: clone_and_extract.py --lang {py,ts,java}
# ---------------------------------------------------------------------
vibebench/corpus/ai_files/
vibebench/corpus/ai_files_ts/
vibebench/corpus/ai_files_java/

# ---------------------------------------------------------------------
# 3. Caches (1.8 GB) , pure speed, zero information
#    tree_cache      : gzipped per-(repo,sha) source trees
#    java_facts_cache: parsed Java facts, keyed by tree content hash
#                      (self-invalidating via _parser_fingerprint)
#    embed_cache     : GraphCodeBERT vectors from the failed embed
#                      experiment; kept locally, not needed to reproduce
# ---------------------------------------------------------------------
vibebench/corpus/tree_cache/
vibebench/corpus/java_facts_cache/
vibebench/corpus/embed_cache.sqlite

# ---------------------------------------------------------------------
# 4. The source dataset (3.2 GB)
#    AIDev parquet shards , a public dataset. Do not vendor it; record
#    where it came from instead (see PROJECT.md).
# ---------------------------------------------------------------------
AIDev-full/

# ---------------------------------------------------------------------
# 5. Build outputs and dependencies
#    package-lock.json and pom.xml ARE committed, so both are
#    reproducible: `npm ci` and `mvn -o package`.
# ---------------------------------------------------------------------
node_modules/
vibebench/03_principles/ts_sidecar/node_modules/
vibebench/03_principles/java_sidecar/target/
tools/target/
__pycache__/
*.pyc
*.pyo

# ---------------------------------------------------------------------
# 6. Third-party binaries
#    DesigniteJava is redistributed under its own licence , link to it
#    from tools/README.md rather than vendoring the jar.
# ---------------------------------------------------------------------
*.jar

# ---------------------------------------------------------------------
# 7. Local session files. CLAUDE.md IS tracked (decision reversed 2026-09-06):
#    it is the orientation document a returning session reads first, and keeping
#    it out of git left it as the only copy on one machine. `.claude/` stays out,
#    since it holds per-machine tool state rather than project knowledge.
# ---------------------------------------------------------------------
.claude/

# ---------------------------------------------------------------------
#    Thesis source IS tracked (decision reversed 2026-09-06). It was kept
#    local, which left the only copy of it on one laptop before a defence.
#    The source is text and diffs well; only LaTeX build output is ignored,
#    since it is regenerated by any compile and would otherwise churn.
# ---------------------------------------------------------------------
thesis/**/*.aux
thesis/**/*.log
thesis/**/*.out
thesis/**/*.toc
thesis/**/*.lof
thesis/**/*.lot
thesis/**/*.bbl
thesis/**/*.blg
thesis/**/*.snm
thesis/**/*.nav
thesis/**/*.fls
thesis/**/*.fdb_latexmk
thesis/**/*.synctex.gz
thesis/**/*.xdv

# ---------------------------------------------------------------------
#    Visual guides at the repo root. Leading slash = root only, so any
#    future .html inside vibebench/ would still be tracked.
# ---------------------------------------------------------------------
/*.html

# ---------------------------------------------------------------------
# 8. Local noise
# ---------------------------------------------------------------------
desktop.ini
Thumbs.db
.DS_Store
*.log
.vscode/

# ---------------------------------------------------------------------
# NOT ignored, deliberately , the irreplaceable set:
#   vibebench/corpus/*.parquet   all results, every principle+language
#   vibebench/labels/            741 hand-judged rows + batch material
#   vibebench/04_report/*.csv    generated reports incl. the cross-check
#   vibebench/**/*.py            the whole pipeline
#   vibebench/03_principles/ts_sidecar/*.js + package-lock.json
#   vibebench/03_principles/java_sidecar/src/ + pom.xml
#   tools/*.csv, *.xml, *.patched, README.md
#   *.md, *.html, thesis/
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
#  Raw AIDev dataset downloads (13 GB) -- ADDED 2026-08-27.
#  `datasets/AIDev-7.6M/` is the upstream HuggingFace release the corpus is
#  curated FROM. It is a public download, identical for everyone, and is
#  re-fetchable; committing it would push 13 GB of somebody else's data to a
#  repo whose entire committed set is ~35 MB. The curated OUTPUT
#  (gold_set*.parquet) is committed and records every (repo, pr_number,
#  merge_sha) needed to rebuild from it.
#
#  This was NOT ignored until now, so a plain `git add .` would have tried to
#  commit the whole release.
# ---------------------------------------------------------------------
datasets/
AIDev-full/
AIDev/
# Run logs are noise, but the Python analysis outputs are not: the thesis
# verifier parses py2_model.txt, and the other two carry reported figures.
logs_archive/*
!logs_archive/py2_model.txt
!logs_archive/py2_report.txt
!logs_archive/py2_cross_language.txt

# Python V2 intermediates: per-shard parquets are merged into the canonical
# *_results.parquet by merge_py_shards.py; pilots and V1 files moved aside
# are superseded. Regenerable, and committing them invites reading the wrong one.
vibebench/corpus/*.shard*of6.parquet
vibebench/corpus/*.shard*of6.DONE.json
vibebench/corpus/*.PILOT.parquet
vibebench/corpus/*.V1-ORIG-moved-aside.parquet
vibebench/corpus/py2_stage.txt
vibebench/config.py.bak-*

# ---------------------------------------------------------------------
#    Cross-check per-class join, 63 MB and regenerable by
#    run_crosscheck_java.py. The summary JSON carries every reported
#    figure, so nothing analytical is lost by keeping this out.
# ---------------------------------------------------------------------
vibebench/04_report/java_crosscheck_classes.csv

# LaTeX build artifacts (thesis and presentation). main.pdf IS tracked.
thesis/**/*.aux
thesis/**/*.log
thesis/**/*.nav
thesis/**/*.out
thesis/**/*.snm
thesis/**/*.toc
thesis/**/*.lof
thesis/**/*.lot
thesis/**/*.fls
thesis/**/*.fdb_latexmk
thesis/**/*.blg
thesis/**/*.xdv
thesis/**/*.synctex.gz
!logs_archive/java_validation.txt
!logs_archive/py2_validation.txt

# pptx export tooling: node deps are reinstallable
thesis/presentation/export/node_modules/
thesis/presentation/export/package-lock.json
thesis/presentation/export/package.json
thesis/presentation/export/build/
thesis/presentation/export/figs/
thesis/presentation/export/deck.json
